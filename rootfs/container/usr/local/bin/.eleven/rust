#!/bin/sh
  FN=$(echo "${1}" | tr '[:upper:]' '[:lower:]')
  shift

  case "${FN}" in
    "build")
      # eleven rust build monolith /monolith
      cargo build --release
      mv ./target/release/${1} ${2}
    ;;

    *)
      eleven log warning "function ${FN} does not exist"
      exit 1
    ;;
  esac