#!/bin/sh
  # prints a log message to stdout formatted as a json object
  # eleven log info "just an info message"

  LOG_DATE=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")
  LOG_TYPE=$(echo "${1}" | awk 'BEGIN { getline; print toupper($0) }')
  LOG_MESSAGE=${2}

  NC='\033[0m'
  COLOUR=''

  case ${LOG_TYPE} in
    DEBUG|DBG|DEB)
      LOG_TYPE="DBG"
      COLOUR='\033[0;35m'
    ;;

    INFO|INF|IN)
      LOG_TYPE="INF"
    ;;

    WARNING|WARN|WRN)
      LOG_TYPE="WRN"
      COLOUR='\033[1;33m'
    ;;

    ERROR|ERR)
      LOG_TYPE="ERR"
      COLOUR='\033[0;31m'
    ;;

    START)
      LOG_TYPE="INF"
      LOG_MESSAGE="starting ${APP_NAME} v${APP_VERSION}"
    ;;

    PATCH|FIX)
      LOG_TYPE="FIX"
    ;;

    *)
      LOG_TYPE="INF"
    ;;
  esac

  if [ ! -z ${DEBUG} ] || { [ -z ${DEBUG} ] && [ "${LOG_TYPE}" != "DBG" ]; }; then
    if [ -z ${ELEVEN_LOG_USE_COLOUR} ]; then
      echo "{\"time\":\"${LOG_DATE}\",\"type\":\"${LOG_TYPE}\",\"msg\":\"${LOG_MESSAGE}\"}"
    else
      echo -e "${COLOUR}{\"time\":\"${LOG_DATE}\",\"type\":\"${LOG_TYPE}\",\"msg\":\"${LOG_MESSAGE}\"}${NC}"
    fi
  fi
